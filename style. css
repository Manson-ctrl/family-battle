* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #111827;
    color: white;
    font-family: Arial, sans-serif;
    text-align: center;
    overflow: hidden;
}

h1 {
    margin: 6px;
    font-size: 25px;
}


/* =========================
   HUD
========================= */

#hud {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 5px 12px;
    font-size: 14px;
    font-weight: bold;
}

.health {
    width: 140px;
    height: 13px;
    background: #222;
    border: 1px solid white;
    border-radius: 8px;
    overflow: hidden;
    margin: 3px auto;
}

#playerHealth {
    width: 100%;
    height: 100%;
    background: limegreen;
    transition: width 0.15s linear;
}

#kills {
    font-size: 18px;
}


/* =========================
   GAME
========================= */

#game {
    position: relative;

    width: 100%;

    height: 72vh;

    background-image:
        url("grok_1787435629909.jpg");

    background-size: cover;

    background-position: center;

    overflow: hidden;

    border: 2px solid white;

    touch-action: none;
}


/* =========================
   SUCCESS
========================= */

#player {
    position: absolute;

    left: 50%;

    bottom: 35px;

    font-size: 70px;

    transform:
        translateX(-50%);

    z-index: 30;

    user-select: none;
}


/* =========================
   ENEMY
========================= */

.enemy {
    position: absolute;

    width: 65px;

    text-align: center;

    z-index: 15;

    pointer-events: none;
}

.enemyBody {
    font-size: 55px;

    filter:
        drop-shadow(
            0 0 8px
            rgba(255, 50, 50, 0.8)
        );
}


/* =========================
   ENEMY HEALTH
========================= */

.enemyHp {
    width: 60px;

    height: 7px;

    background: #222;

    border: 1px solid white;

    margin: auto;

    overflow: hidden;
}

.enemyHpBar {
    width: 100%;

    height: 100%;

    background: red;

    transition:
        width 0.1s linear;
}


/* =========================
   PLAYER BULLET
========================= */

.bullet {
    position: absolute;

    font-size: 25px;

    z-index: 25;

    pointer-events: none;
}


/* =========================
   ENEMY BULLET
========================= */

.enemyBullet {
    position: absolute;

    font-size: 25px;

    z-index: 28;

    pointer-events: none;

    user-select: none;
}


/* =========================
   CONTROLS
========================= */

.controls {
    display: flex;

    justify-content: center;

    gap: 20px;

    margin-top: 8px;
}

.controls button {
    width: 85px;

    height: 58px;

    border: none;

    border-radius: 12px;

    font-size: 20px;

    font-weight: bold;

    touch-action: none;

    user-select: none;
}

#fireButton {
    width: 115px;

    background: red;

    color: white;
}

.controls button:active {
    transform: scale(0.90);
}