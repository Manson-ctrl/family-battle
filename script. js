const game = document.getElementById("game");
const player = document.getElementById("player");

const leftBtn = document.getElementById("leftBtn");
const rightBtn = document.getElementById("rightBtn");
const fireButton = document.getElementById("fireButton");

const playerHealthBar =
    document.getElementById("playerHealth");

const playerHealthText =
    document.getElementById("playerHealthText");

const killCount =
    document.getElementById("killCount");


/* =========================
   PLAYER
========================= */

let playerX = 50;

let playerHealth = 1000;

const MAX_HEALTH = 1000;

let movingLeft = false;
let movingRight = false;

const PLAYER_SPEED = 2;


/* =========================
   GAME OBJECTS
========================= */

let bullets = [];
let enemyBullets = [];
let enemies = [];

let kills = 0;

let lastShot = 0;

const SHOT_DELAY = 200;


/* =========================
   PLAYER MOVEMENT
========================= */

function updatePlayer() {

    if (movingLeft) {
        playerX -= PLAYER_SPEED;
    }

    if (movingRight) {
        playerX += PLAYER_SPEED;
    }

    if (playerX < 5) {
        playerX = 5;
    }

    if (playerX > 95) {
        playerX = 95;
    }

    player.style.left =
        playerX + "%";
}


/* =========================
   LEFT BUTTON
========================= */

leftBtn.addEventListener(
    "pointerdown",
    function(event) {

        event.preventDefault();

        movingLeft = true;
    }
);

leftBtn.addEventListener(
    "pointerup",
    function() {

        movingLeft = false;
    }
);

leftBtn.addEventListener(
    "pointercancel",
    function() {

        movingLeft = false;
    }
);

leftBtn.addEventListener(
    "pointerleave",
    function() {

        movingLeft = false;
    }
);


/* =========================
   RIGHT BUTTON
========================= */

rightBtn.addEventListener(
    "pointerdown",
    function(event) {

        event.preventDefault();

        movingRight = true;
    }
);

rightBtn.addEventListener(
    "pointerup",
    function() {

        movingRight = false;
    }
);

rightBtn.addEventListener(
    "pointercancel",
    function() {

        movingRight = false;
    }
);

rightBtn.addEventListener(
    "pointerleave",
    function() {

        movingRight = false;
    }
);


/* =========================
   KEYBOARD
========================= */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key === "ArrowLeft" ||
            event.key.toLowerCase() === "a"
        ) {

            movingLeft = true;
        }

        if (
            event.key === "ArrowRight" ||
            event.key.toLowerCase() === "d"
        ) {

            movingRight = true;
        }

        if (event.code === "Space") {

            shoot();
        }
    }
);


document.addEventListener(
    "keyup",
    function(event) {

        if (
            event.key === "ArrowLeft" ||
            event.key.toLowerCase() === "a"
        ) {

            movingLeft = false;
        }

        if (
            event.key === "ArrowRight" ||
            event.key.toLowerCase() === "d"
        ) {

            movingRight = false;
        }
    }
);


/* =========================
   SHOOT
========================= */

function shoot() {

    const now = Date.now();

    if (
        now - lastShot <
        SHOT_DELAY
    ) {
        return;
    }

    lastShot = now;

    const bullet =
        document.createElement("div");

    bullet.className =
        "bullet";

    bullet.textContent =
        "🔥";

    bullet.style.left =
        playerX + "%";

    bullet.style.bottom =
        "100px";

    game.appendChild(bullet);

    bullets.push(bullet);
}


/* =========================
   FIRE BUTTON
========================= */

fireButton.addEventListener(
    "pointerdown",
    function(event) {

        event.preventDefault();

        shoot();
    }
);


/* =========================
   CREATE ENEMY
========================= */

function createEnemy() {

    const enemy =
        document.createElement("div");

    enemy.className =
        "enemy";


    const body =
        document.createElement("div");

    body.className =
        "enemyBody";

    body.textContent =
        "👾";


    const hp =
        document.createElement("div");

    hp.className =
        "enemyHp";


    const hpBar =
        document.createElement("div");

    hpBar.className =
        "enemyHpBar";


    hp.appendChild(hpBar);

    enemy.appendChild(body);

    enemy.appendChild(hp);


    const maxLeft =
        game.clientWidth - 70;

    const randomLeft =
        Math.random() * maxLeft;


    enemy.style.left =
        randomLeft + "px";

    enemy.style.top =
        "-80px";


    enemy.health = 100;

    enemy.speed =
        0.5 +
        Math.random() * 0.7;


    enemy.lastAttack =
        Date.now();

    enemy.attackDelay =
        3000 +
        Math.random() * 2500;


    game.appendChild(enemy);

    enemies.push(enemy);
}


/* =========================
   SPAWN ENEMIES
========================= */

for (
    let i = 0;
    i < 4;
    i++
) {

    setTimeout(
        createEnemy,
        i * 700
    );
}


setInterval(
    function() {

        if (
            enemies.length < 7
        ) {

            createEnemy();
        }

    },
    1500
);


/* =========================
   ENEMY SHOOT
========================= */

function enemyShoot(enemy) {

    const bullet =
        document.createElement("div");

    bullet.className =
        "enemyBullet";

    bullet.textContent =
        "💣";


    const enemyX =
        parseFloat(
            enemy.style.left
        ) + 30;

    const enemyY =
        parseFloat(
            enemy.style.top
        ) + 55;


    bullet.style.left =
        enemyX + "px";

    bullet.style.top =
        enemyY + "px";


    bullet.dx = 0;

    bullet.dy = 4;


    game.appendChild(bullet);

    enemyBullets.push(bullet);
}


/* =========================
   ENEMY BULLETS
========================= */

function updateEnemyBullets() {

    for (
        let i =
        enemyBullets.length - 1;

        i >= 0;

        i--
    ) {

        const bullet =
            enemyBullets[i];


        let top =
            parseFloat(
                bullet.style.top
            );


        top += bullet.dy;


        bullet.style.top =
            top + "px";


        if (
            checkCollision(
                bullet,
                player
            )
        ) {

            bullet.remove();

            enemyBullets.splice(
                i,
                1
            );

            damagePlayer(10);

            continue;
        }


        if (
            top >
            game.clientHeight
        ) {

            bullet.remove();

            enemyBullets.splice(
                i,
                1
            );
        }
    }
}


/* =========================
   ENEMIES
========================= */

function updateEnemies() {

    const now =
        Date.now();


    for (
        let i =
        enemies.length - 1;

        i >= 0;

        i--
    ) {

        const enemy =
            enemies[i];


        let top =
            parseFloat(
                enemy.style.top
            );


        top += enemy.speed;


        enemy.style.top =
            top + "px";


        /* Enemy attacks */

        if (
            now -
            enemy.lastAttack >=
            enemy.attackDelay
        ) {

            enemy.lastAttack =
                now;

            enemyShoot(enemy);
        }


        /* Enemy touches player */

        if (
            checkCollision(
                enemy,
                player
            )
        ) {

            damagePlayer(10);

            enemy.remove();

            enemies.splice(i, 1);

            createEnemy();

            continue;
        }


        /* Enemy leaves */

        if (
            top >
            game.clientHeight
        ) {

            enemy.remove();

            enemies.splice(i, 1);

            createEnemy();
        }
    }
}


/* =========================
   PLAYER BULLETS
========================= */

function updateBullets() {

    for (
        let i =
        bullets.length - 1;

        i >= 0;

        i--
    ) {

        const bullet =
            bullets[i];


        let bottom =
            parseFloat(
                bullet.style.bottom
            );


        bottom += 16;


        bullet.style.bottom =
            bottom + "px";


        for (
            let j =
            enemies.length - 1;

            j >= 0;

            j--
        ) {

            const enemy =
                enemies[j];


            if (
                checkCollision(
                    bullet,
                    enemy
                )
            ) {

                enemy.health -= 25;

                updateEnemyHealth(
                    enemy
                );


                bullet.remove();

                bullets.splice(i, 1);


                if (
                    enemy.health <= 0
                ) {

                    enemy.remove();

                    enemies.splice(
                        j,
                        1
                    );

                    kills++;

                    killCount.textContent =
                        kills;

                    createEnemy();
                }


                break;
            }
        }


        if (
            bottom >
            game.clientHeight
        ) {

            bullet.remove();

            bullets.splice(i, 1);
        }
    }
}


/* =========================
   ENEMY HEALTH
========================= */

function updateEnemyHealth(enemy) {

    const bar =
        enemy.querySelector(
            ".enemyHpBar"
        );


    bar.style.width =
        enemy.health + "%";
}


/* =========================
   PLAYER DAMAGE
========================= */

function damagePlayer(amount) {

    playerHealth -= amount;


    if (
        playerHealth < 0
    ) {

        playerHealth = 0;
    }


    playerHealthBar.style.width =
        (
            playerHealth /
            MAX_HEALTH *
            100
        ) + "%";


    playerHealthText.textContent =
        playerHealth +
        " / " +
        MAX_HEALTH;


    if (
        playerHealth <= 0
    ) {

        alert(
            "SUCCESS HAS FALLEN!\n\n" +
            "KILLS: " +
            kills
        );

        location.reload();
    }
}


/* =========================
   COLLISION
========================= */

function checkCollision(a, b) {

    const rectA =
        a.getBoundingClientRect();

    const rectB =
        b.getBoundingClientRect();


    return (
        rectA.left < rectB.right &&
        rectA.right > rectB.left &&
        rectA.top < rectB.bottom &&
        rectA.bottom > rectB.top
    );
}


/* =========================
   GAME LOOP
========================= */

function gameLoop() {

    updatePlayer();

    updateBullets();

    updateEnemyBullets();

    updateEnemies();

    requestAnimationFrame(
        gameLoop
    );
}


gameLoop();